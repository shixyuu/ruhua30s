# ======== 《入画三十秒》环境变量 ========
# 你的域名（DNS A 记录需指向本 VPS 公网 IP），Caddy 会自动申请 HTTPS 证书
DOMAIN=art.yourdomain.com

# Node 服务监听端口（Docker 部署时容器内固定 3000；PM2 裸机部署时生效）
PORT=3000

# 时区：决定归档文件名时间戳与 /api/archive “今天”的判定
TZ=America/Toronto

# 可选：后台口令。设置后需访问 /admin?token=你的口令，归档照片也需要口令才能查看
ADMIN_TOKEN=

# 仅开发联调用：把所有阶段时长按比例缩短（例如 0.1 = 十倍速）。生产环境务必保持 1
TIME_SCALE=1
