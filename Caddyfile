# 只需在 .env 中设置 DOMAIN=art.yourdomain.com，Caddy 会自动申请 / 续期 Let's Encrypt 证书。
# reverse_proxy 原生支持 WebSocket Upgrade，/ws 无需额外配置。
{$DOMAIN} {
	encode zstd gzip

	reverse_proxy app:3000 {
		# 实时流：立即刷新，不缓冲
		flush_interval -1
		# 长连接：WebSocket 由服务端每 20s Ping 保活
		transport http {
			keepalive 90s
		}
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		# 允许页面使用摄像头 / 麦克风 / 全屏 / 防熄屏
		Permissions-Policy "camera=(self), microphone=(self), fullscreen=(self), screen-wake-lock=(self)"
	}

	log {
		output stdout
		format console
	}
}
